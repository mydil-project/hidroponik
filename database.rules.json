{
  "rules": {
    ".read": false,
    ".write": false,

    "konfigurasi": {
      ".read": true,
      ".write": "auth != null && root.child('izin').child(auth.uid).val() === true",
      "mode": {
        ".validate": "newData.isString() && (newData.val() === 'auto' || newData.val() === 'manual')"
      },
      "manual": {
        ".validate": "newData.isBoolean()"
      }
    },

    "izin": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "perangkat": {
      "$perangkat": {
        ".read": true,
        ".write": "auth != null && auth.admin === true"
      }
    }
  }
}